{
  "name": "find-the-flag",
  "version": "0.1.0",
  "description": "Open-source, 100% client-side toolbox for solving CTF challenges.",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run i18n:check && npm run check:privacy",
    "docs:tools": "node scripts/gen-tools-doc.mjs",
    "check:privacy": "node scripts/check-privacy.mjs",
    "i18n:extract": "node scripts/i18n.mjs extract",
    "i18n:check": "node scripts/i18n.mjs check"
  },
  "dependencies": {
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-devanagari": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@noble/ciphers": "2.4.0",
    "exifr": "^7.1.3",
    "fast-png": "^8.0.0",
    "fflate": "^0.8.3",
    "hash-wasm": "^4.12.0",
    "jpeg-js": "^0.4.4",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=20"
  }
}
